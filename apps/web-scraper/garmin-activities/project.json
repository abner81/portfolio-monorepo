{
  "name": "garmin-activities",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-scraper/garmin-activities/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "docker:up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f apps/web-scraper/garmin-activities/docker-compose.yml up -d",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f apps/web-scraper/garmin-activities/docker-compose.yml down",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web-scraper/garmin-activities/jest.config.ts",
        "passWithNoTests": true,
        "coverage": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/web-scraper/garmin-activities",
        "outputFileName": "main.js",
        "webpackConfig": "apps/web-scraper/garmin-activities/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "serve": {
          "watch": true
        },
        "production": {}
      }
    },

    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build", "docker:up"],
      "options": {
        "buildTarget": "garmin-activities:build",
        "inspect": false,
        "watch": true,
        "debounce": 300,
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "garmin-activities:build:serve"
        },
        "production": {
          "buildTarget": "garmin-activities:build:production"
        }
      }
    }
  }
}
